{
  "name": "helperplan",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "build:deno": "nuxt build --preset=deno_deploy",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:api": "vitest run --project=api",
    "test:app": "vitest run  --project=app",
    "test:workflow": "vitest run  --project=workflow",
    "test:a11y": "node scripts/accessibility-test.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.9.0",
    "@nuxt/ui": "^4.9.0",
    "@nuxtjs/i18n": "^10.4.0",
    "@opentelemetry/api": "^1.9.1",
    "@pinia/nuxt": "0.11.3",
    "@vueuse/nuxt": "14.3.0",
    "nuxt": "^4.4.8",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.3.1",
    "vue": "^3.5.38",
    "vue-router": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@axe-core/playwright": "^4.11.3",
    "@iconify-json/lucide": "^1.2.114",
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/test-utils": "^4.0.3",
    "@vitest/ui": "4.1.9",
    "@vue/test-utils": "^2.4.11",
    "@vueuse/core": "^14.3.0",
    "eslint": "^10.5.0",
    "eslint-plugin-format": "^2.0.1",
    "happy-dom": "^20.10.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "playwright": "^1.61.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "chokidar": "5.0.0"
  },
  "lint-staged": {
    "*.{js,ts,vue,mjs,mts}": "eslint --fix"
  }
}
